# ---------------------------------------------------------------------------
# Auth — Better Auth (email+password sign-up/sign-in; Google / GitHub optional)
# Better Auth owns /api/auth/*. Registration is OPEN; optionally gate it by
# setting AUTH_SIGNUP_ALLOWLIST (comma-separated emails — any other identity
# creation is then blocked).
# AUTH_SIGNUP_ALLOWLIST=owner@example.com,teammate@example.com
# ---------------------------------------------------------------------------
# BETTER_AUTH_SECRET=                 # openssl rand -base64 32
# BETTER_AUTH_URL=http://localhost:3000
# Google: OAuth client (Web) → redirect URI /api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub: OAuth App → callback URL /api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Database (optional)
# Without DATABASE_URL the app boots an embedded PGlite Postgres in ./.data/pglite
# For production, point this at any hosted Postgres. sslmode=require is needed
# by Aiven and most cloud providers (postgres-js reads it from the URI).
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ---------------------------------------------------------------------------
# AI provider — OpenCode Go (recommended if you have a Go subscription)
# OpenAI-compatible endpoint: https://opencode.ai/zen/go/v1
# Latest DeepSeek: deepseek-flash (DeepSeek V4.1 Flash)
# Other Go models: kimi-k2.7-code, glm-5.2/5.3, qwen3.8-flash, minimax-m3, ...
# Note: deepseek-v4-pro requires a China-hosting opt-in for your workspace.
# ---------------------------------------------------------------------------
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_MODEL=deepseek-flash
# LLM_PROVIDER=opencode-go

# ---------------------------------------------------------------------------
# AI provider alternatives (auto-detected when OpenCode Go is not configured)
# Order: OpenCode Go > Groq > OpenAI > Gemini > built-in demo
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# GOOGLE_GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Integrations (optional) — https://docs.composio.dev
# Without a key the app uses simulated connections and tool outputs.
# ---------------------------------------------------------------------------
# COMPOSIO_API_KEY=

# ---------------------------------------------------------------------------
# Browser automation (optional) — https://browserbase.com
# Without keys the built-in simulated browser is used.
# When the free-plan agent quota runs out, the adapter automatically falls
# back to Browserbase Fetch/Search APIs, then to simulation.
# ---------------------------------------------------------------------------
# BROWSERBASE_API_KEY=
# BROWSERBASE_AGENT_ID=
# BROWSERBASE_TIMEOUT_MS=180000
# BROWSERBASE_FALLBACK_TO_SIMULATION=true
# BROWSER_MAX_CALLS_PER_RUN=4

# ---------------------------------------------------------------------------
# Execution guardrails (optional)
# ---------------------------------------------------------------------------
# RUN_TIMEOUT_MS=600000     # abort a run after 10 minutes
# TOOL_TIMEOUT_MS=240000    # abort a single tool call after 4 minutes

# ---------------------------------------------------------------------------
# Background scheduling (optional)
# The built-in scheduler runs automatically on server start.
# For Inngest Cloud / dev server: `npx inngest-cli@latest dev`
# ---------------------------------------------------------------------------
# INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# SCHEDULER_DISABLED=1

# ---------------------------------------------------------------------------
# Billing — Dodo Payments (Merchant of Record) — https://dodopayments.com
# Without keys the app stays zero-config and live runs are unlocked locally.
# Test keys start with dodo_test_, live keys with dodo_live_.
# Create the Pro products with: bun run dodo:setup
# ---------------------------------------------------------------------------
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_PAYMENTS_WEBHOOK_KEY=          # Dashboard → Developer → Webhooks
# DODO_BILLING_CURRENCY=            # optional: force checkout currency (e.g. USD)
# DODO_PRODUCT_PRO_MONTHLY=           # pdt_... (subscription, $12/month)
# DODO_PRODUCT_PRO_YEARLY=            # pdt_... (subscription, $120/year)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Security — set this to protect the cron endpoint in production
# ---------------------------------------------------------------------------
# CRON_SECRET=
